# --- build stage -------------------------------------------------------------
FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Static, stripped binary so it runs on a minimal base image.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/server .

# --- runtime stage -----------------------------------------------------------
FROM alpine:3.20
# ca-certificates: needed for outbound HTTPS calls to the Discord API.
RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 appuser
WORKDIR /app

COPY --from=build /out/server /app/server
# Seed data is only used by the dev-gated DB_ACTION=seed path, but it is tiny
# and keeps the image usable for staging environments.
COPY --from=build /src/database/seeds /app/database/seeds

USER appuser
EXPOSE 8080
CMD ["/app/server"]
