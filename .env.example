# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# The backend fails fast on startup if any required variable is missing.

# --- Discord OAuth (https://discord.com/developers/applications) --------------
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# --- Database -----------------------------------------------------------------
DB_NAME="tierlist"
DB_USER="tierlist"
DB_PASSWORD="change-me"
DB_HOST="postgres"          # compose service name
DB_PORT="5432"
DB_SSLMODE="disable"        # "disable" for in-network container Postgres; "require" for a managed DB
# One-shot schema actions, then the process exits. Leave empty for normal runs.
#   migrate  -> AutoMigrate (forward-only in prod; drops+recreates only when APP_ENV=dev)
#   seed / clear -> dev only
DB_ACTION=""

# --- App environment ----------------------------------------------------------
APP_ENV="dev"                          # "dev" locally; "production" when hosted
PORT="8080"

# Local dev values (defaults shown). For production set these to your HTTPS domain:
#   APP_URL="https://tierlist.example.com"
#   FRONTEND_URL="https://tierlist.example.com"
#   COOKIE_DOMAIN="tierlist.example.com"
APP_URL="http://localhost:8080"        # backend base URL; OAuth redirect is APP_URL + /api/auth/discord/callback
FRONTEND_URL="http://localhost:4200"   # where the OAuth callback returns the browser
COOKIE_DOMAIN="localhost"

# --- Reverse proxy (prod compose only) ----------------------------------------
DOMAIN="localhost"                     # domain Caddy serves + gets TLS for

# --- Image tags (prod compose on the VM; CI sets these to ghcr.io tags) --------
# BACKEND_IMAGE="ghcr.io/<owner>/tierlist-backend:latest"
# FRONTEND_IMAGE="ghcr.io/<owner>/tierlist-frontend:latest"
