# Production (VM deploy, or a local prod-parity test). Copy to .env and fill
# in, then run:
#   docker compose -f docker-compose.prod.yml up --build
# The backend fails fast on startup if any required variable is missing or
# misconfigured.

# --- Discord OAuth (https://discord.com/developers/applications) --------------
# Redirect URI registered in the portal must be https://<your-domain>/api/auth/discord/callback
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# --- Database -------------------------------------------------------------
DB_NAME="tierlist"
DB_USER="tierlist"
DB_PASSWORD="change-me"     # use a strong random password
DB_HOST="postgres"          # compose service name
DB_PORT="5432"
DB_SSLMODE="disable"        # fine: Postgres is on the private compose network; "require" for a managed/remote DB
# One-shot schema action, then the process exits. Leave empty for normal runs.
#   migrate -> forward-only AutoMigrate (never drops data in production)
DB_ACTION=""

# --- App environment ----------------------------------------------------------
APP_ENV="production"
PORT="8080"
DOMAIN="tierlist.example.com"                 # domain Caddy serves + gets TLS for
APP_URL="https://tierlist.example.com"        # must be HTTPS; backend base URL, OAuth redirect is APP_URL + /api/auth/discord/callback
FRONTEND_URL="https://tierlist.example.com"   # where the OAuth callback returns the browser
COOKIE_DOMAIN="tierlist.example.com"          # required; "localhost" only valid for a local prod-parity test

# --- Image tags (prod compose on the VM; CI sets these to ghcr.io tags) --------
# Omit both for a local `--build` (images are tagged *:local instead).
# BACKEND_IMAGE="ghcr.io/<owner>/tierlist-backend:latest"
# FRONTEND_IMAGE="ghcr.io/<owner>/tierlist-frontend:latest"
